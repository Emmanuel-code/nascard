# Paystack Secret Key
# Get yours at https://dashboard.paystack.com/#/settings/developer
# Use TEST key (sk_test_...) for dev, LIVE key (sk_live_...) for production
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_TEST_KEY

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...

# Server Port
PORT=3000
