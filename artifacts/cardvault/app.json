{
  "expo": {
    "name": "nascard Wallet",
    "slug": "septnova",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nascard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nascard.app"
    },
    "android": {
      "package": "com.nascard.app",
      "versionCode": 17,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#080C16"
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-brightness",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "nascard needs access to your photos to capture card images.",
          "cameraPermission": "nascard needs camera access to scan and photograph your cards."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7150ee1e-f0b5-4db0-a016-49d8106d6fd9"
      }
    },
    "owner": "septnovas-team"
  }
}
